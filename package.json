{
  "name": "fangyu-code",
  "private": true,
  "version": "2.7.1",
  "description": "Fangyu 专属 AI 开发工具",
  "author": "Fangyu",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "pwsh -File build.ps1",
    "tauri:build-ci": "tauri build",
    "tauri:build-fast": "tauri build --debug",
    "tauri:dev": "tauri dev",
    "deploy": "pwsh -File deploy.ps1",
    "deploy:skip-build": "pwsh -File deploy.ps1 -SkipBuild",
    "deploy:no-install": "pwsh -File deploy.ps1 -SkipInstall",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --exclude '**/*.property.test.ts'",
    "test:property": "vitest run --include '**/*.property.test.ts'"
  },
