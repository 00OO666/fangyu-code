{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fangyu Code",
  "version": "2.9.3",
  "identifier": "com.fangyu.code",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fangyu Code",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "visible": true,
        "devtools": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost http://asset.localhost tauri: blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: https://ipc.localhost https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://api.github.com https://raw.githubusercontent.com https://q.us-east-1.amazonaws.com wss://* ws://localhost:*; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/00OO666/fangyu-code/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3RDM5MTZEQjEwNzlDNzQKUldSMG5BZXhiWkhUSi9HM1R0ODViYU5lTlYyTE9CeE1aRGR1QjdYc1l5VjZaSVJ1Y0c2QzkrdmsK"
    },
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "copyright": "© 2025 Fangyu",
    "category": "DeveloperTool",
    "shortDescription": "Fangyu 专属 AI 开发工具",
    "longDescription": "Fangyu Code 是专为 Fangyu 定制的 AI 开发工具，基于 Claude Code CLI 打造。提供直观的界面用于 AI 驱动的开发工作流、项目管理和高级 AI 交互。",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}