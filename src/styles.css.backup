@import "tailwindcss";

/*
 * MODERN DESIGN SYSTEM - Material 3 Inspired
 *
 * This file now serves as the main entry point for styles,
 * importing modularized CSS files for better maintainability.
 */

@import "./styles/theme.css";
@import "./styles/typography.css";
@import "./styles/animations.css";
@import "./styles/components.css";

/* ========================================
   CUSTOM STYLES
   ======================================== */

/* Ensure container is centered on all platforms */
.container {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

/* macOS specific fixes for WebKit */
@supports (-webkit-backdrop-filter: blur(1px)) {
  /*
   * Removed legacy flexbox hacks that were causing layout issues on modern macOS/WebKit.
   * Modern browsers (including Safari) support standard flexbox properties perfectly.
   * Forcing -webkit-box (2009 syntax) was conflicting with modern layouts.
   */
}
