// Feature System Initialization Module
window.FeaturesInit = (function() {
    'use strict';

    const features = {
        docsSystem: null,
        inquiryForm: null,
        analytics: null,
        aiAutomation: null,
        ga4Analytics: null
    };

    function initAll(options) {
        const config = Object.assign({
            language: 'en',
            ga4MeasurementId: null,
            ga4ApiKey: null,
            apiBaseUrl: '/',
            enableDocumentation: true,
            enableInquiries: true,
            enableAnalytics: true,
            enableAI: true,
            enableGA4: false
        }, options);

        try {
            // Initialize Documentation System
            if (config.enableDocumentation && window.DocsSystem) {
                features.docsSystem = window.DocsSystem;
                window.DocsSystem.init({
                    apiUrl: config.apiBaseUrl + 'api-docs.php',
                    searchUrl: config.apiBaseUrl + 'api-search.php',
                    language: config.language
                });
                console.log('✓ Documentation System initialized');
            }

            // Initialize Inquiry Form
            if (config.enableInquiries && window.InquiryForm) {
                features.inquiryForm = window.InquiryForm;
                window.InquiryForm.init({
                    submitUrl: config.apiBaseUrl + 'api-inquiries.php',
                    language: config.language
                });
                console.log('✓ Inquiry Form initialized');
            }

            // Initialize Analytics (Local)
            if (config.enableAnalytics && window.Analytics) {
                features.analytics = window.Analytics;
                window.Analytics.init({
                    apiUrl: config.apiBaseUrl + 'api-analytics.php',
                    trackPageViews: true,
                    trackEvents: true
                });
                console.log('✓ Analytics initialized');
            }

            // Initialize Google Analytics 4
            if (config.enableGA4 && window.GA4Analytics) {
                if (!config.ga4MeasurementId) {
                    console.warn('GA4: Measurement ID not provided');
                } else {
                    features.ga4Analytics = window.GA4Analytics;
                    window.GA4Analytics.init({
                        measurementId: config.ga4MeasurementId,
                        apiKey: config.ga4ApiKey || ''
                    });
                    console.log('✓ Google Analytics 4 initialized');
                }
            }

            // Initialize AI Automation
            if (config.enableAI && window.AIAutomation) {
                features.aiAutomation = window.AIAutomation;
                window.AIAutomation.init({
                    aiApiUrl: config.apiBaseUrl + 'api-ai-generate.php',
                    language: config.language
                });
                console.log('✓ AI Automation initialized');
            }

            console.log('✓ All features initialized successfully');
            return true;

        } catch (error) {
            console.error('Feature initialization error:', error);
            return false;
        }
    }

    function getFeature(featureName) {
        return features[featureName] || null;
    }

    return {
        initAll: initAll,
        getFeature: getFeature,
        features: features
    };
})();
