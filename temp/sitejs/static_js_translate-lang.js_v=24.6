    // ==================== 品牌名称管理 ====================
    var BRAND_NAME = 'FANGYU';

    function ensureBrandName() {
        var isChinese = (currentLang.code === 'CN' || currentLang.code === 'TW');
        var targetName = isChinese ? '方昱' : BRAND_NAME;
        var allForms = ['FANGYU', '方玉', '方昱', 'ファンユー', 'فانغيو', '팡위', 'Фанъюй', 'ฟางหยู'];
        var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
        var changedCount = 0;

        while(walker.nextNode()) {
            var node = walker.currentNode;
            
            // 跳过 notranslate 元素
            var parent = node.parentElement;
            if (parent && (parent.classList.contains('notranslate') || parent.classList.contains('brand-name'))) {
                continue;
            }
            
            var text = node.textContent;
            var originalText = text;
            allForms.forEach(function(form) {
                if (form !== targetName && text.indexOf(form) !== -1) {
                    text = text.split(form).join(targetName);
                }
            });
            if (text !== originalText) {
                node.textContent = text;
                changedCount++;
            }
        }
        console.log('[Lang v24] 品牌名处理完成，共替换', changedCount, '处');
    }

