    // ==================== 专业术语纠正机制（核心）====================
    function correctWrongTranslations() {
        var langCode = LANG_CODE_MAP[currentLang.code];
        if (!langCode) {
            console.warn('[Lang v24] 未知语言代码:', currentLang.code);
            return;
        }

        var corrections = TRANSLATION_CORRECTIONS[langCode];
        if (!corrections || Object.keys(corrections).length === 0) {
            console.log('[Lang v24] 该语言无需纠正:', langCode);
            return;
        }

        console.log('[Lang v24] 开始纠正翻译错误，目标语言:', langCode, '纠正条目:', Object.keys(corrections).length);

        var replaceCount = 0;
        var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
        var processedNodes = new Set();

        while(walker.nextNode()) {
            var node = walker.currentNode;
            
            // 跳过已处理的节点（避免重复处理）
            if (processedNodes.has(node)) {
                continue;
            }
            
            // 跳过 ignore、notranslate、brand-name 类的元素
            var parent = node.parentElement;
            if (parent && (parent.classList.contains('ignore') || parent.classList.contains('notranslate') || parent.classList.contains('brand-name'))) {
                continue;
            }
            
            var text = node.textContent;
            var originalText = text;
            var changed = false;

            Object.keys(corrections).forEach(function(wrongTerm) {
                var correctTerm = corrections[wrongTerm];
                if (text.indexOf(wrongTerm) !== -1) {
                    text = text.split(wrongTerm).join(correctTerm);
                    changed = true;
                }
            });

            if (changed && text !== originalText) {
                node.textContent = text;
                processedNodes.add(node);
                replaceCount++;
            }
        }

        console.log('[Lang v24] 翻译纠正完成，共处理', replaceCount, '处文本节点');
    }


