        { code: 'AR', native: 'العربية', iso: 'arabic', htmlLang: 'ar', flag: '🇸🇦' },
        { code: 'TH', native: 'ไทย', iso: 'thai', htmlLang: 'th', flag: '🇹🇭' },
        { code: 'VN', native: 'Tiếng Việt', iso: 'vietnamese', htmlLang: 'vi', flag: '🇻🇳' },
        { code: 'ID', native: 'Indonesia', iso: 'indonesian', htmlLang: 'id', flag: '🇮🇩' },
        { code: 'TR', native: 'Türkçe', iso: 'turkish', htmlLang: 'tr', flag: '🇹🇷' },
        { code: 'PL', native: 'Polski', iso: 'polish', htmlLang: 'pl', flag: '🇵🇱' },
        { code: 'NL', native: 'Nederlands', iso: 'dutch', htmlLang: 'nl', flag: '🇳🇱' },
        { code: 'HI', native: 'हिन्दी', iso: 'hindi', htmlLang: 'hi', flag: '🇮🇳' }
    ];

    var currentLang = LANGUAGES[0];
    var translateReady = false;
    var STORAGE_KEY = 'fangyu_preferred_language';
    var menuElement = null;
    var triggerElement = null;

    // ==================== 工具函数 ====================
    function saveLanguagePreference(langCode) {
        try { localStorage.setItem(STORAGE_KEY, langCode); } catch (e) {}
    }

    function loadLanguagePreference() {
        try {
            var saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                var lang = LANGUAGES.find(function(l) { return l.code === saved; });
                if (lang) return lang;
            }
        } catch (e) {}
        return null;
    }

    function updateHtmlLang(lang) {
        var html = document.documentElement;
        if (html && lang.htmlLang) html.setAttribute('lang', lang.htmlLang);
    }

    // ==================== 语言切换 ====================
    function selectLanguage(lang) {
        if (!lang || currentLang.code === lang.code) {
            closeMenu();
            return;
        }

        console.log('[Lang v24] 切换语言:', lang.native, '(' + lang.code + ')');
        currentLang = lang;
        saveLanguagePreference(lang.code);
        updateHtmlLang(lang);
        updateUI();
        closeMenu();

        if (translateReady && typeof translate !== 'undefined' && typeof translate.changeLanguage === 'function') {
            translate.changeLanguage(lang.iso);

            // 多次执行纠正，确保所有内容都被修正
            setTimeout(function() { translateNavigation(); translatePagination(); translateNewsHero(); correctWrongTranslations(); }, 1000);
            setTimeout(function() { translateNavigation(); translatePagination(); translateNewsHero(); correctWrongTranslations(); ensureBrandName(); }, 2000);
        }
    }

    function updateUI() {
        var codeEl = document.getElementById('currentLangCode');
        if (codeEl) codeEl.textContent = currentLang.code;

        if (!menuElement) return;
        var items = menuElement.querySelectorAll('.lang-option');
        items.forEach(function(item) {
            var itemCode = item.getAttribute('data-code');
            item.classList.toggle('active', itemCode === currentLang.code);
        });
    }

    function toggleMenu() {
        if (!menuElement) return;
        if (menuElement.classList.contains('show')) closeMenu();
        else openMenu();
    }

    function openMenu() {
        if (!menuElement || !triggerElement) return;
        menuElement.classList.add('show');
        positionMenu();
        window.addEventListener('resize', positionMenu);
    }

    function closeMenu() {
        if (!menuElement) return;
        menuElement.classList.remove('show');
        window.removeEventListener('resize', positionMenu);
    }

    function positionMenu() {
        if (!menuElement || !triggerElement) return;
        var rect = triggerElement.getBoundingClientRect();
        var menuWidth = menuElement.offsetWidth;
        var left = rect.left + (rect.width / 2) - (menuWidth / 2);
        var top = rect.bottom + 8;
        if (left + menuWidth > window.innerWidth) left = window.innerWidth - menuWidth - 10;
        if (left < 10) left = 10;
        menuElement.style.top = top + 'px';
        menuElement.style.left = left + 'px';
    }

    function createMenu() {
        var menu = document.createElement('div');
        menu.className = 'lang-menu';
        menu.id = 'langMenu';

        var html = '';
        LANGUAGES.forEach(function(lang) {
            var isActive = lang.code === currentLang.code;
            html += '<div class="lang-option' + (isActive ? ' active' : '') + '" data-code="' + lang.code + '">';
            html += '<span class="lang-option-flag">' + lang.flag + '</span>';
            html += '<span class="lang-option-name">' + lang.native + '</span>';
            html += '</div>';
        });

        menu.innerHTML = html;
        document.body.appendChild(menu);

        var items = menu.querySelectorAll('.lang-option');
        items.forEach(function(item, index) {
            item.addEventListener('click', function(e) {
                e.stopPropagation();
                selectLanguage(LANGUAGES[index]);
            });
        });

        return menu;
    }

    function initTranslateJS() {
        if (typeof translate === 'undefined') return false;
        try {
            translate.service.use('client.edge');
            return true;
        } catch (error) {
            return false;
        }
    }

    function checkTranslateJS() {
        var checkCount = 0;
        var maxChecks = 20;

        var interval = setInterval(function() {
            checkCount++;

            if (typeof translate !== 'undefined' && translate.changeLanguage) {
                translateReady = true;
                clearInterval(interval);
                initTranslateJS();

                var savedLang = loadLanguagePreference();
                if (savedLang) {
                    if (savedLang.code !== 'EN') {
                        setTimeout(function() { selectLanguage(savedLang); }, 1000);
                    } else {
                        // 英文也需要执行翻译纠正
                        currentLang = savedLang;
                        setTimeout(function() { translateNavigation(); translatePagination(); translateNewsHero(); correctWrongTranslations(); }, 1500);
                        setTimeout(function() { translateNavigation(); translatePagination(); translateNewsHero(); correctWrongTranslations(); ensureBrandName(); }, 2500);
                    }
                } else {
                    setTimeout(function() { ensureBrandName(); }, 1200);
                }
            } else if (checkCount >= maxChecks) {
                clearInterval(interval);
            }
        }, 500);
    }

    function init() {
        console.log('[Lang v23.0] 初始化（完整多语言版）');

        triggerElement = document.getElementById('langTrigger');
        if (!triggerElement) return;

        menuElement = createMenu();

        triggerElement.addEventListener('click', function(e) {
            e.stopPropagation();
            toggleMenu();
        });

        document.addEventListener('click', function(e) {
            if (menuElement && !menuElement.contains(e.target) && e.target !== triggerElement) {
                closeMenu();
            }
        });

        var oldList = document.getElementById('langList');
        if (oldList) oldList.style.display = 'none';

        checkTranslateJS();

        // 统计纠正条目
        var totalCorrections = 0;
        Object.keys(TRANSLATION_CORRECTIONS).forEach(function(lang) {
            totalCorrections += Object.keys(TRANSLATION_CORRECTIONS[lang]).length;
        });
        console.log('[Lang v23.0] 初始化完成 - 总计', totalCorrections, '条翻译纠正');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    window.langSwitcher = {
        version: '23.4',
        currentLang: function() { return currentLang; },
        selectLanguage: selectLanguage,
        correctWrongTranslations: correctWrongTranslations,
        getCorrectionCount: function() {
            var total = 0;
            Object.keys(TRANSLATION_CORRECTIONS).forEach(function(lang) {
                total += Object.keys(TRANSLATION_CORRECTIONS[lang]).length;
            });
            return total;
        }
    };

    console.log('[Lang v23.0] 完整多语言翻译系统已加载');

})();
